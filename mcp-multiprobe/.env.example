# Multiprobe MS SQL Server connection.
# Use a login with SELECT-only permissions — the server's own query guard is
# defense-in-depth, not a substitute for real DB-level restrictions.

MULTIPROBE_DB_SERVER=multiprobe-db.example.com
MULTIPROBE_DB_PORT=1433
MULTIPROBE_DB_DATABASE=Multiprobe
MULTIPROBE_DB_USER=multiprobe_readonly
MULTIPROBE_DB_PASSWORD=changeme

# Set to "true" if the server requires TLS but uses a self-signed/internal cert.
MULTIPROBE_DB_ENCRYPT=true
MULTIPROBE_DB_TRUST_SERVER_CERT=false
